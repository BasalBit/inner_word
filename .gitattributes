# Text files are stored and checked out with LF line endings.
* text=auto eol=lf

# Pictures and the app icon are binary: never diffed or converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.woff2 binary

# The landing page and the notes are documentation, not the app's languages on GitHub.
site/** linguist-documentation
docs/** linguist-documentation

# The whiteboard's built folder: minified JavaScript, fonts and lists the build writes, reviewed
# through its sources and `node build.mjs --check`, not line by line.
crates/innerword-board-web/dist/** -diff linguist-generated
