<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist for The Writer.app. scripts/bundle.sh copies this file into the bundle and
  overwrites CFBundleShortVersionString and CFBundleVersion with the cargo workspace
  version. LSMinimumSystemVersion is the single source of truth for the minimum macOS
  version: bundle.sh reads it and builds with MACOSX_DEPLOYMENT_TARGET set to the same
  value. 10.15.7 is what gpui 0.2.2 targets (its build.rs compiles the Metal shaders with
  -mmacosx-version-min=10.15.7; newer APIs are behind runtime version checks). Apple
  Silicon builds can never run below macOS 11.0, whatever this says.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleName</key>
	<string>The Writer</string>
	<key>CFBundleDisplayName</key>
	<string>The Writer</string>
	<key>CFBundleIdentifier</key>
	<string>app.thewriter.TheWriter</string>
	<key>CFBundleExecutable</key>
	<string>the-writer</string>
	<key>CFBundleIconFile</key>
	<string>TheWriter</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>0.0.0</string>
	<key>CFBundleVersion</key>
	<string>0.0.0</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>MacOSX</string>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>10.15.7</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>NSRequiresAquaSystemAppearance</key>
	<false/>
</dict>
</plist>
